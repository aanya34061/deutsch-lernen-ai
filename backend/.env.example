# German Learning App - Backend Environment Configuration

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=german_learning

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# AI & LLM (Ollama - Free & Local)
OLLAMA_BASE_URL=http://localhost:11434
# Practical small model recommendations: qwen2.5:3b (default), llama3.2:3b, gemma2:2b, mistral:7b
OLLAMA_MODEL=qwen2.5:3b
# Free local embedding model for Ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30.0

# Retrieval-Augmented Generation (RAG)
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_MAX_CHUNKS=4
RAG_SIMILARITY_THRESHOLD=0.12
CHAT_MAX_HISTORY_MESSAGES=10
CHAT_MAX_MESSAGE_LENGTH=2000

# Speech to Text / Text to Speech
STT_PROVIDER=browser
TTS_PROVIDER=browser

# Security / browser access
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
