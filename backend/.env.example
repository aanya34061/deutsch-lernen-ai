# German Learning App - Backend Environment Configuration

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=german_learning

# Authentication cookies are host-only, HttpOnly for sessions, and SameSite=Strict.
SESSION_COOKIE_NAME=deutsch_session
SESSION_TTL_DAYS=14
# Optional trusted origins for a separate frontend. Same-origin production needs no CORS origins.
CORS_ORIGINS=

# Persistent files. local is for development only; production requires s3-compatible storage.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PRESIGNED_URL_SECONDS=300

# AI is disabled unless explicitly configured. Use ollama for local development.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30.0

# Optional hosted OpenAI-compatible provider. Keep these values on the backend only.
# AI_PROVIDER=openai-compatible
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBED_MODEL=

# Retrieval-Augmented Generation (RAG)
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_MAX_CHUNKS=4
RAG_SIMILARITY_THRESHOLD=0.12
CHAT_MAX_HISTORY_MESSAGES=10
CHAT_MAX_MESSAGE_LENGTH=2000

# Speech to Text / Text to Speech
STT_PROVIDER=browser
TTS_PROVIDER=browser
